@namespace Todo.Blazor.Components.Todos
@using Todo.Todos
@using Todo.Todos.Dto
@using Todo.Localization
@using Volo.Abp.Validation
@using Volo.Abp.Http.Client

@inject ITodoItemAppService TodoItemAppService
@inject IStringLocalizer<TodoResource> L
@inject IUiNotificationService UiNotificationService

<Modal @ref="_modal">
    <ModalContent Centered Size="ModalSize.Large">
        <ModalHeader>
            <ModalTitle>@(_isEditMode ? L["EditATask"] : L["CreateANewTask"])</ModalTitle>
            <CloseButton />
        </ModalHeader>

        <ModalBody>
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <Alert Color="Color.Danger" Visible>
                    <AlertMessage>@_errorMessage</AlertMessage>
                </Alert>
            }

            @if (_isEditMode)
            {
                <!-- Update form - all fields are nullable -->
                <Fields>
                    <Field>
                        <TextInput type="text" @bind-Value="@_updateInput.Title"
                                   Placeholder="It will not change unless you enter anything" />

                    </Field>

                    <Field ColumnSize="ColumnSize.Is12">
                        <FieldLabel>Description</FieldLabel>
                        <TextInput type="text" @bind-Value="@_updateInput.Description"
                                   Placeholder="It will not change unless you enter anything" />
                    </Field>

                    <Field ColumnSize="ColumnSize.Is6">
                        <FieldLabel>Due Date</FieldLabel>
                        <DatePicker TValue="DateTime?" @bind-Value="_updateInput.DueDate" InputMode="DateInputMode.DateTime"
                                    DefaultHour="12" DefaultMinute="00" />
                    </Field>

                    <Field ColumnSize="ColumnSize.Is6">
                        <FieldLabel>Priority</FieldLabel>
                        <Select TValue="Priority?" @bind-Value="_updateInput.Priority">
                            @foreach (var p in Enum.GetValues<Priority>())
                            {
                                <SelectItem Value="@((Priority?)p)">@L[$"Enum:Priority:{p}"]</SelectItem>
                            }
                        </Select>
                    </Field>

                    <Field ColumnSize="ColumnSize.Is6">
                        <FieldLabel>Status</FieldLabel>
                        <Select TValue="bool?" @bind-Value="_updateInput.IsDone">
                            <SelectItem Value="@((bool?)false)">Unfinished</SelectItem>
                            <SelectItem Value="@((bool?)true)">Finished</SelectItem>
                        </Select>
                    </Field>
                </Fields>
            }
            else
            {
                <!-- Create form - Title & Description are required -->
                <Fields>
                    <Field ColumnSize="ColumnSize.Is12">
                        <FieldLabel>Title <span class="text-danger">*</span></FieldLabel>
                        <TextInput @bind-Value="_createInput.Title" Placeholder="Enter the title..." />
                    </Field>

                    <Field ColumnSize="ColumnSize.Is12">
                        <FieldLabel>Description <span class="text-danger">*</span></FieldLabel>
                        <TextInput @bind-Value="_createInput.Description" Placeholder="Enter the description" />
                    </Field>

                    <Field ColumnSize="ColumnSize.Is6">
                        <FieldLabel>Due Date </FieldLabel>
                        <DatePicker TValue="DateTime?" @bind-Value="_createInput.DueDate"
                                    InputMode="DateInputMode.DateTime" />
                    </Field>

                    <Field ColumnSize="ColumnSize.Is6">
                        <FieldLabel>Priority </FieldLabel>
                        <Select TValue="Priority?" @bind-Value="_createInput.Priority">
                            @foreach (var p in Enum.GetValues<Priority>())
                            {
                                <SelectItem Value="@((Priority?)p)">@L[$"Enum:Priority:{p}"]</SelectItem>
                            }
                        </Select>
                    </Field>
                </Fields>
            }
        </ModalBody>

        <ModalFooter>
            <Button Color="Color.Secondary" Clicked="Close">@L["Cancel"]</Button>
            <Button Color="Color.Primary" Clicked="HandleSubmit" Loading="_isLoading">
                @(_isEditMode ? @L["Update"] : @L["Create"])
            </Button>
        </ModalFooter>
    </ModalContent>
</Modal>

@code {
    [Parameter] public EventCallback OnSaved { get; set; }

    private Modal _modal = default!;
    private bool _isEditMode;
    private bool _isLoading;
    private string _errorMessage = "";

    private CreateTodoItemDto _createInput = new CreateTodoItemDto();
    private UpdateTodoItemDto _updateInput = new UpdateTodoItemDto();

    public async Task OpenCreate()
    {
        _isEditMode = false;
        _createInput = new CreateTodoItemDto
        {
            DueDate = DateTime.UtcNow.AddDays(1),
            Priority = Priority.Medium
        };

        _errorMessage = "";

        await _modal.Show();
    }



    public async Task OpenEdit(TodoItemDto item)
    {
        _isEditMode = true;
        _updateInput = new UpdateTodoItemDto
        {
            Id = item.Id,
            Title = item.Title,
            Description = item.Description,
            DueDate = item.DueDate,
            Priority = item.Priority,
            IsDone = item.IsDone
        };

        _errorMessage = "";
        await _modal.Show();
    }

    private async Task HandleSubmit()
    {
        _isLoading = true;
        _errorMessage = "";

        try
        {
            if (_isEditMode)
            {
                await TodoItemAppService.UpdateAsync(_updateInput);
                await UiNotificationService.Success(L["TaskWasUpdatedSuccessfully"]);
            }
            else
            {
                await TodoItemAppService.CreateAsync(_createInput);
                await UiNotificationService.Success(L["TaskWasCreatedSuccessfully"]);
            }

            await _modal.Hide();

            await OnSaved.InvokeAsync();
        }
        catch (AbpValidationException ex)
        {
            _errorMessage = string.Join(separator: ", ", ex.ValidationErrors.Select(e => e.ErrorMessage));
        }
        catch (BusinessException ex)
        {
            _errorMessage = L[ex.Message];
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error happen: {L[ex.Message]}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task Close()
    {
        await _modal.Hide();
        _errorMessage = "";
    }
}
