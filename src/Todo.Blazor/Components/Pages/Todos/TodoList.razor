@namespace Todo.Blazor.Components.Todos
@page "/todos"
@attribute [Authorize]
@using Todo.Todos
@using Todo.Todos.Dto
@using Todo.Localization
@using Todo.Permissions
@using Volo.Abp.Application.Dtos
@using Volo.Abp.Users
@inject ICurrentUser CurrentUser
@inject ITodoItemAppService TodoItemAppService
@inject IStringLocalizer<TodoResource> L
@inject IAuthorizationService AuthorizationService
@inject IUiMessageService UiMessageService
@inject IUiNotificationService UiNotificationService

<Card>
    <CardHeader>
        <Div Class="d-flex justify-content-between align-items-center">
            <CardTitle>
                @L["TodoList"]
            </CardTitle>
            @if (_canCreate)
            {
                <Button
                    Color="Color.Primary"
                    Size="Size.Small"
                    Clicked="OpenCreate">
                    <Icon Name="IconName.Add" />
                    @L["CreateNew"]
                </Button>
            }
        </Div>
    </CardHeader>
    <CardBody>
        <Row Class="mb-3">
            <Column ColumnSize="ColumnSize.Is2">
                <TextInput @bind-Value="@_filter.FilterText" Placeholder="Find by string.." @bind-Value:after="LoadData" />
            </Column>
            <Column ColumnSize="ColumnSize.Is2">
                <Select TValue="Priority?" @bind-Value="_filter.Priority" @bind-Value:after="LoadData" >
                    <SelectItem Value="@((Priority?)null)"> -- All -- </SelectItem>
                    @foreach (var p in Enum.GetValues<Priority>())
                    {
                        <SelectItem Value="@((Priority?)p)">
                            @L[$"Enum:Priority:{p}"]
                        </SelectItem>
                    }
                </Select>
            </Column>
            <Column ColumnSize="ColumnSize.Is2">
                <Select TValue="bool?" @bind-Value="_filter.IsDone" @bind-Value:after="LoadData" >
                    <SelectItem Value="@((bool?)null)">-- All --</SelectItem>
                    <SelectItem Value="@((bool?)false)">Unfinished</SelectItem>
                    <SelectItem Value="@((bool?)true)">Finished</SelectItem>
                </Select>
            </Column>

            <Column ColumnSize="ColumnSize.Is2">
                <DatePicker TValue="DateTime?" 
                            Value="_filter.DueDateFrom"
                            InputMode="DateInputMode.DateTime"
                            TimeAs24hr="true"
                            ValueChanged="OnDueDateFromChanged"
                            Placeholder="@L["DueDateFrom"]" />
            </Column>

            <Column ColumnSize="ColumnSize.Is2">
                <DatePicker TValue="DateTime?" 
                            Value="_filter.DueDateTo"
                            InputMode="DateInputMode.DateTime"
                            TimeAs24hr="true"
                            ValueChanged="OnDueDateToChanged"
                            Placeholder="@L["DueDateTo"]" />
            </Column>
            
            <Column ColumnSize="ColumnSize.Is2">
                <Button
                    Color="Color.Secondary"
                    Clicked="ResetFilter"
                    Block>
                    Reset Filter
                </Button>
            </Column>
        </Row>
        <DataGrid
            TItem="TodoItemDto"
            Data="_items"
            Responsive
            Hoverable
            Striped
            ShowPager
            PageSize="10"
            TotalItems="_totalCount"
            EmptyText="No task yet.">
            <DataGridColumns>
                <DataGridColumn
                    TItem="TodoItemDto"
                    Field="@nameof(TodoItemDto.Title)"
                    Caption="Title" />
                <DataGridColumn
                    TItem="TodoItemDto"
                    Field="@nameof(TodoItemDto.Description)"
                    Caption="Description" />
                <DataGridColumn
                    TItem="TodoItemDto"
                    Field="@nameof(TodoItemDto.Priority)"
                    Caption="Priority">
                    <DisplayTemplate>
                        <Badge Color="@GetPriorityColor(context.Item.Priority)">
                            @L[$"Enum:Priority:{context.Item.Priority}"]
                        </Badge>
                    </DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn
                    TItem="TodoItemDto"
                    Field="@nameof(TodoItemDto.DueDate)"
                    Caption="Due date">
                    <DisplayTemplate>
                    @context.Item.DueDate.ToString("yyyy-MM-dd HH:mm:ss")
                    </DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn
                    TItem="TodoItemDto"
                    Field="@nameof(TodoItemDto.IsDone)"
                    Caption="Status">
                    <DisplayTemplate>
                        @if (context.Item.IsDone)
                        {
                            <Badge Color="Color.Success">Finished</Badge>
                        }
                        else
                        {
                            <Badge Color="Color.Warning">Unfinished</Badge>
                        }
                    </DisplayTemplate>
                </DataGridColumn>
                @if (_isAdmin)
                {
                    <DataGridColumn
                        TItem="TodoItemDto"
                        Field="@nameof(TodoItemDto.CreatorUserName)"
                        Caption="Creator UserName" />
                }
                <DataGridColumn TItem="TodoItemDto" Caption="Actions">
                    <DisplayTemplate>
                        <Div Flex="Flex.Row" Gap="Gap.Is1">
                            @if (_canUpdate)
                            {
                                <Button
                                    Color="Color.Primary"
                                    Size="Size.Small"
                                    Outline
                                    Clicked="@(() => OpenEdit(context.Item))">
                                    <Icon Name="IconName.Edit" />
                                </Button>
                            }
                            @if (!context.Item.IsDone)
                            {
                                <Button
                                    Color="Color.Success"
                                    Size="Size.Small"
                                    Outline
                                    Clicked="@(() => MarkAsDone(context.Item.Id))">
                                    <Icon Name="IconName.Check" />
                                </Button>
                            }
                            @if (_canDelete)
                            {
                                <Button
                                    Color="Color.Danger"
                                    Size="Size.Small"
                                    Outline
                                    Clicked="@(() => Delete(context.Item.Id))">
                                    <Icon Name="IconName.Delete" />
                                </Button>
                            }
                        </Div>
                    </DisplayTemplate>
                </DataGridColumn>
            </DataGridColumns>
        </DataGrid>
    </CardBody>
</Card>
<TodoItemModal @ref="_modal" OnSaved="LoadData" />

@code
{
    private bool _isAdmin;

    private List<TodoItemDto> _items = new List<TodoItemDto>();

    private int _totalCount;

    private TodoItemModal _modal = default!;

    private bool _canCreate;

    private bool _canUpdate;

    private bool _canDelete;

    private GetTodoListDto _filter = new GetTodoListDto()
    {
        MaxResultCount = 50,
        Sorting = "DueDate asc"
    };

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = CurrentUser.IsInRole(Roles.Admin);

        _canCreate = await AuthorizationService.IsGrantedAsync(TodoPermissions.Todos.Create);

        _canUpdate = await AuthorizationService.IsGrantedAsync(TodoPermissions.Todos.Update);

        _canDelete = await AuthorizationService.IsGrantedAsync(TodoPermissions.Todos.Delete);

        await LoadData();
    }

    private async Task LoadData()
    {
        PagedResultDto<TodoItemDto>? result = await TodoItemAppService.GetListAsync(_filter);

        _items = result.Items.ToList();

        _totalCount = (int)result.TotalCount;
    }

    private async Task ResetFilter()
    {
        _filter.FilterText = null;
        _filter.IsDone = null;
        _filter.Priority = null;
        _filter.DueDateFrom = null;
        _filter.DueDateTo = null;
        _filter.Sorting = "DueDate asc";

        await LoadData();
    }

    private Task OpenCreate() => _modal.OpenCreate();

    private Task OpenEdit(TodoItemDto item) => _modal.OpenEdit(item);

    private async Task MarkAsDone(Guid id)
    {
        UpdateTodoItemDto markAsDone = new UpdateTodoItemDto()
        {
            Id = id,
            IsDone = true
        };

        await TodoItemAppService.UpdateAsync(markAsDone);

        await UiNotificationService.Success(message: "Đã đánh dấu hoàn thành");

        await LoadData();
    }

    private async Task Delete(Guid id)
    {
        bool confirmed = await UiMessageService.Confirm(message: "Bạn có chắc muốn xóa task?", title: "Xác nhận xóa");
        if (!confirmed) return;

        await TodoItemAppService.DeleteAsync(id);

        await UiNotificationService.Success(message: "Xóa task thành công");

        await LoadData();
    }

    private Color GetPriorityColor(Priority priority) => priority switch
    {
        Priority.High => Color.Danger,

        Priority.Medium => Color.Warning,

        _ => Color.Secondary
    };

    private Task OnDueDateFromChanged(DateTime? value)
    {
        _filter.DueDateFrom = value;
    
        _ = Task.Run(async () => await InvokeAsync(async () =>
        {
            await Task.Yield();
            await LoadData();
            StateHasChanged();
        }));
        
        return Task.CompletedTask;
    }

    private Task OnDueDateToChanged(DateTime? value)
    {
        _filter.DueDateTo = value;

        _ = Task.Run(async () => await InvokeAsync(async () =>
        {
            await Task.Yield();
            await LoadData();
            StateHasChanged();
        }));
        
        return Task.CompletedTask;
    }
}
